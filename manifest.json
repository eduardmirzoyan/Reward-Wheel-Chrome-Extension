{
  "manifest_version": 3,
  "name": "Habit Reward Wheel",
  "version": "1.1.0",
  "description": "Spin a reward wheel to celebrate building good habits.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Habit Reward Wheel",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
